{
  "name": "sagar-monorepo",
  "version": "1.0.0",
  "description": "Sagar Monorepo",
  "scripts": {
    "server": "cd server && npm run start",
    "server-dev": "cd server && npm run dev",
    "web": "cd web && npm run start",
    "web-dev": "cd web && npm run dev",
    "publish-desktop-app": "cd web/build && npm run publish",
    "build-web": "cd web && npm run build",
    "build-desktop-app": "cd web/build && npm run build",
    "install-web": "cd web && npm install",
    "install-server": "cd server && npm install",
    "install-desktop-app": "cd web/build && npm install",
    "install": "npm run install-web && npm run install-server",
    "lint": "npx eslint .",
    "prettier": "npx prettier .",
    "fix:format": "npx prettier --write .",
    "prepare": "husky",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,css,md}": "prettier --write"
  },
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@eslint/compat": "^1.1.0",
    "@eslint/js": "^9.5.0",
    "commitizen": "^4.3.0",
    "cz-git": "^1.9.4",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.2"
  }
}
